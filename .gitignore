# Legacy plugin checkouts are preserved locally but no longer loaded by Vim.
vim/.vim/bundle/
# Ignore the old Pathogen installation and Vim's runtime state.
vim/.vim/autoload/
vim/.vim/backup/
vim/.vim/swp
vim/.vim/undo

# git configuration file is generated
git/.gitconfig.local

# Ignore file generated by newsboat
newsboat/.newsboat/cache.db
newsboat/.newsboat/history.cmdline
newsboat/.newsboat/history.search
