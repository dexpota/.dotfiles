[submodule "vim/.vim/bundle/colorschemes"]
	path = vim/.vim/pack/plugins/start/colorschemes
	url = https://github.com/flazz/vim-colorschemes.git
	ignore = dirty
[submodule "vim/.vim/bundle/tabular"]
	path = vim/.vim/pack/plugins/start/tabular
	url = https://github.com/godlygeek/tabular.git
[submodule "config/.config/kitty/kitty-themes"]
	path = config/.config/kitty/kitty-themes
	url = https://github.com/dexpota/kitty-themes
	branch = master
[submodule "vim/.vim/bundle/goyo"]
	path = vim/.vim/pack/plugins/start/goyo
	url = https://github.com/junegunn/goyo.vim.git
[submodule "vim/.vim/bundle/vim-pencil"]
	path = vim/.vim/pack/plugins/start/vim-pencil
	url = https://github.com/reedes/vim-pencil.git
[submodule "vim/.vim/bundle/vim-surround"]
	path = vim/.vim/pack/plugins/start/vim-surround
	url = https://github.com/tpope/vim-surround.git
